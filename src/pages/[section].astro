---
import SectionPage from "../components/SectionPage.astro";
export function getStaticPaths() {
  return (["projects", "courses", "about", "contact"] as const).map(
    (section) => ({
      params: { section },
      props: { section },
    }),
  );
}
---

<SectionPage section={Astro.props.section} locale="en" />
