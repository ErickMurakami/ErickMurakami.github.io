---
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection } from "astro:content";
import { githubProjects } from "../../lib/projects";
const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const additional = githubProjects.filter(
  (repo) => !projects.some((p) => p.data.repo === repo.name),
);
---

<Layout title="Projects">
  <section class="shell section">
    <div class="page-intro">
      <p class="eyebrow">PROJECT INDEX</p>
      <h1>
        Backend engineering,
        <br />
        <span class="blue">in practice.</span>
      </h1>
      <p>
        Four focused studies in domain logic, reactive persistence, rate
        limiting, and tenant isolation. Each connects implementation details to
        source evidence.
      </p>
    </div>
    <div class="project-grid">
      {projects.map((p) => (
        <ProjectCard project={p} />
      ))}
    </div>
    {additional.length > 0 && (
      <section class="section">
        <div class="section-heading">
          <div>
            <p class="eyebrow">FROM GITHUB</p>
            <h2>More public work.</h2>
            <p>
              Repository metadata only. Technical case studies have not been
              curated yet.
            </p>
          </div>
        </div>
        <div class="project-grid">
          {additional.map((repo) => (
            <article class="project-card">
              <p class="eyebrow">PUBLIC REPOSITORY</p>
              <h3>{repo.name}</h3>
              <p class="card-description">
                {repo.description ?? "Explore the source repository."}
              </p>
              <ul class="tags">
                {repo.language && <li>{repo.language}</li>}
                {repo.topics
                  .filter((topic) => topic !== "portfolio")
                  .map((topic) => (
                    <li>{topic}</li>
                  ))}
              </ul>
              <p class="hero-caption">
                Updated{" "}
                <time datetime={repo.updatedAt}>
                  {repo.updatedAt.slice(0, 10)}
                </time>
              </p>
              <a class="text-link" href={repo.url}>
                View source on GitHub ↗
              </a>
            </article>
          ))}
        </div>
      </section>
    )}
  </section>
</Layout>
