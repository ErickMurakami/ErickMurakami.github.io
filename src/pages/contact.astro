---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact">
  <section class="shell section">
    <div class="page-intro">
      <p class="eyebrow">CONTACT</p>
      <h1>
        Let’s talk
        <br />
        <span class="blue">backend engineering.</span>
      </h1>
      <p>
        Interested in my work or an engineering conversation? You can find my
        public projects and professional profile on GitHub.
      </p>
      <a class="button primary" href="https://github.com/ErickMurakami">
        Connect on GitHub ↗
      </a>
    </div>
    <div class="empty-state">
      <h2>Start with the code.</h2>
      <p>
        Explore the case studies for context on how I approach architecture,
        implementation, and technical trade-offs.
      </p>
      <a class="text-link" href="/projects/">
        Explore projects →
      </a>
    </div>
  </section>
</Layout>
