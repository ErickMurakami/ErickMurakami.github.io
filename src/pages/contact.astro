---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact">
  <section class="shell section">
    <div class="page-intro">
      <p class="eyebrow">CONTACT</p>
      <h1>
        Let’s talk
        <br />
        <span class="blue">backend engineering.</span>
      </h1>
      <p>
        Interested in my work or an engineering conversation? You can find my
        public projects on GitHub and connect with me on LinkedIn.
      </p>
      <div class="actions">
        <a
          class="button primary"
          href="https://www.linkedin.com/in/erick-murakami"
        >
          Connect on LinkedIn ↗
        </a>
        <a class="button" href="https://github.com/ErickMurakami">
          GitHub ↗
        </a>
      </div>
    </div>
    <section class="empty-state">
      <p class="eyebrow">RESUME</p>
      <h2>My engineering background.</h2>
      <p>Download my resume in English or Portuguese.</p>
      <div class="actions">
        <a class="button" href="/resume/erick-murakami-resume-en.pdf" download>
          Resume · English ↓
        </a>
        <a
          class="button"
          href="/resume/erick-murakami-curriculo-pt.pdf"
          download
        >
          Currículo · Português ↓
        </a>
      </div>
    </section>
    <div class="empty-state" style="margin-top:24px">
      <h2>Start with the code.</h2>
      <p>
        Explore the case studies for context on how I approach architecture,
        implementation, and technical trade-offs.
      </p>
      <a class="text-link" href="/projects/">
        Explore projects →
      </a>
    </div>
  </section>
</Layout>
