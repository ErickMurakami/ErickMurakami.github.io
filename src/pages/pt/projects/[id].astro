---
import { getCollection, render } from "astro:content";
import TechLabel from "../../../components/TechLabel.astro";
import Layout from "../../../layouts/Layout.astro";
export async function getStaticPaths() {
  return (await getCollection("projectsPt")).map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}
const { project } = Astro.props;
const { Content, headings } = await render(project);
---

<Layout
  title={project.data.title}
  description={project.data.description}
  projectTitle={project.data.title}
>
  <div class="shell section">
    <header class="case-header">
      <p class="eyebrow">ESTUDO DE CASO / {project.data.focus}</p>
      <p class="intro">{project.data.description}</p>
      <ul class="tags">
        {project.data.stack.map((s: string) => (
          <li>
            <TechLabel name={s} />
          </li>
        ))}
      </ul>
      <a
        class="text-link"
        href={`https://github.com/ErickMurakami/${project.data.repo}`}
        target="_blank"
        rel="noopener noreferrer"
      >
        Ver código no GitHub ↗
      </a>
    </header>
    <div class="reading-layout">
      <aside aria-label="On this page">
        <span class="small-label">NESTA PÁGINA</span>
        {headings
          .filter((h) => h.depth === 2)
          .map((h) => (
            <a href={`#${h.slug}`}>{h.text}</a>
          ))}
      </aside>
      <article class="prose">
        <Content />
      </article>
    </div>
  </div>
</Layout>
