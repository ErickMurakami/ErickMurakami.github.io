---
import Layout from "../../layouts/Layout.astro";
import ProjectGallery from "../../components/ProjectGallery.astro";
import TechLabel from "../../components/TechLabel.astro";
import Icon from "../../components/Icon.astro";
import { getCollection } from "astro:content";
const projects = (await getCollection("projectsPt")).sort(
  (a, b) => a.data.order - b.data.order,
);
const notes = (await getCollection("notesPt"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<Layout title="Engenheiro de Software Back-end">
  <section class="shell hero">
    <div class="hero-copy">
      <p class="eyebrow hero-label">
        <span class="dot" /> ECOSSISTEMA JAVA · ENGENHARIA BACKEND
      </p>
      <h1>
        Erick Murakami
        <span class="role">
          Engenheiro
          <br />
          de Software <span class="nowrap">Back-end</span>
          <span class="blue">.</span>
        </span>
      </h1>
      <p class="intro">
        Desenvolvo APIs e aplicações backend em Java, com Quarkus e Spring Boot.
      </p>
      <div class="actions">
        <a class="button primary" href="/pt/#projects">
          Ver projetos <span aria-hidden="true">→</span>
        </a>
        <a class="button" href="https://github.com/ErickMurakami">
          GitHub <Icon />
        </a>
        <a class="button" href="https://www.linkedin.com/in/erick-murakami">
          LinkedIn <Icon />
        </a>
        <a
          class="button"
          href="/resume/erick-murakami-curriculo-pt.pdf"
          download
        >
          Baixar currículo ↓
        </a>
      </div>
      <p class="hero-caption">Java · Quarkus · Spring Boot · PostgreSQL</p>
    </div>
    <div
      class="architecture"
      aria-label="Foco de engenharia: contratos de API, regras de domínio e persistência"
    >
      <div class="diagram-header">
        <span class="dot" /> API, DOMÍNIO E DADOS
      </div>
      <div class="diagram-line">
        <span>01</span>
        <Icon name="globe" />
        <div>
          <strong>API</strong>
          <small>Endpoints e integrações</small>
        </div>
      </div>
      <div class="connector"></div>
      <div class="diagram-line core">
        <span>02</span>
        <Icon name="code" />
        <div>
          <strong>Regras de negócio</strong>
          <small>Validações e operações</small>
        </div>
        <span class="core-label">NÚCLEO</span>
      </div>
      <div class="connector"></div>
      <div class="diagram-line">
        <span>03</span>
        <Icon name="layers" />
        <div>
          <strong>Dados</strong>
          <small>Banco de dados e testes</small>
        </div>
      </div>
      <div class="diagram-footer">
        <span>CONTRATO → DOMÍNIO → DADOS</span>
        <span aria-hidden="true">↗</span>
      </div>
    </div>
  </section>
  <div class="specialty-strip">
    <div class="shell">
      <span>TECNOLOGIAS</span>
      <strong>
        <TechLabel name="Java" />
      </strong>
      <strong>
        <TechLabel name="Quarkus" />
      </strong>
      <strong>
        <TechLabel name="Spring Boot" />
      </strong>
      <strong>
        <TechLabel name="PostgreSQL" />
      </strong>
      <strong>
        <TechLabel name="Docker" />
      </strong>
    </div>
  </div>
  <section id="projects" class="shell section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">PROJETOS</p>
        <h2>Projetos</h2>
        <p>
          O que fiz em cada projeto, como funciona e o que ainda pode melhorar.
        </p>
      </div>
    </div>
    <ProjectGallery projects={projects} locale="pt" />
  </section>
  {notes.length > 0 && (
    <>
      <section id="notes" class="shell section writing">
        <div>
          <p class="eyebrow">03 / NOTAS TÉCNICAS</p>
          <h2>Espaço para aprofundar ideias.</h2>
          <p>
            Detalhes de implementação, questões de arquitetura e aprendizados da
            prática.
          </p>
        </div>
        <div class="notes-preview">
          {notes.length ? (
            notes.map((n) => (
              <a href={`/pt/notes/${n.id}/`}>{n.data.title} →</a>
            ))
          ) : (
            <>
              <span class="small-label">O CADERNO ESTÁ ABERTO</span>
              <p>
                Ainda não há artigos publicados. Por enquanto, explore as
                decisões técnicas documentadas nos estudos de caso.
              </p>
              <a class="text-link" href="/pt/#notes">
                Ver notas técnicas →
              </a>
            </>
          )}
        </div>
      </section>
    </>
  )}
  <section id="about" class="shell section about-summary">
    <div>
      <p class="eyebrow">SOBRE</p>
      <h2>Sobre mim</h2>
    </div>
    <div>
      <p>
        Sou o Erick, engenheiro backend. Trabalho com Java, Spring Boot e
        Quarkus e me interesso por APIs, bancos de dados e sistemas
        distribuídos.
      </p>
      <p>
        Reuni aqui projetos de finanças pessoais, gestão de pedidos, controle de
        requisições e multitenancy. Os estudos de caso mostram a implementação,
        as escolhas e as limitações de cada um.
      </p>
      <a class="text-link" href="https://www.linkedin.com/in/erick-murakami">
        LinkedIn ↗
      </a>
    </div>
  </section>
  <section id="contact" class="shell contact-banner">
    <p class="eyebrow">CONTATO</p>
    <h2>Entre em contato</h2>
    <a class="button primary" href="https://www.linkedin.com/in/erick-murakami">
      LinkedIn <Icon />
    </a>
    <div class="resume-links">
      <a class="text-link" href="/resume/erick-murakami-resume-en.pdf" download>
        Resume · English ↓
      </a>
      <a
        class="text-link"
        href="/resume/erick-murakami-curriculo-pt.pdf"
        download
      >
        Currículo · Português ↓
      </a>
    </div>
  </section>
</Layout>
