---
import Layout from "../../layouts/Layout.astro";
import ProjectGallery from "../../components/ProjectGallery.astro";
import TechLabel from "../../components/TechLabel.astro";
import Icon from "../../components/Icon.astro";
import ExpertiseGrid from "../../components/ExpertiseGrid.astro";
import BlogPreview from "../../components/BlogPreview.astro";
import { getPublishedPosts } from "../../lib/blog";
import { getCollection } from "astro:content";
const projects = (await getCollection("projectsPt")).sort(
  (a, b) => a.data.order - b.data.order,
);
const posts = await getPublishedPosts("pt");
---

<Layout title="Engenheiro de Software Back-end">
  <section class="expertise-showcase" data-expertise-showcase>
    <div class="showcase-sticky">
      <div class="shell hero">
        <div class="hero-copy">
          <h1>
            Erick Murakami
            <span class="role">
              Engenheiro de Software{" "}
              <span class="nowrap">
                Back-end<span class="blue">.</span>
              </span>
            </span>
          </h1>

          <p class="intro">
            Desenvolvo sistemas backend em Java com foco em confiabilidade,
            arquitetura, desempenho e manutenção.
          </p>
          <div class="actions">
            <a class="button primary" href="/pt/#projects">
              Ver projetos <span aria-hidden="true">→</span>
            </a>
            <a class="button" href="https://github.com/ErickMurakami">
              GitHub <Icon />
            </a>
            <a class="button" href="https://www.linkedin.com/in/erick-murakami">
              LinkedIn <Icon />
            </a>
          </div>
          <a
            class="text-link hero-resume"
            href="/resume/erick-murakami-curriculo-pt.pdf"
            download
          >
            Baixar currículo ↓
          </a>
        </div>
        <ExpertiseGrid locale="pt" />
      </div>
      <div class="specialty-strip">
        <div class="shell">
          <span>TECNOLOGIAS</span>
          <strong>
            <TechLabel name="Java" />
          </strong>
          <strong>
            <TechLabel name="Quarkus" />
          </strong>
          <strong>
            <TechLabel name="Spring Boot" />
          </strong>
          <strong>
            <TechLabel name="PostgreSQL" />
          </strong>
          <strong>
            <TechLabel name="Docker" />
          </strong>
        </div>
      </div>
    </div>
  </section>
  <section id="projects" class="shell section">
    <div class="section-heading">
      <div>
        <h2>Projetos</h2>
        <p>
          O que fiz em cada projeto, como funciona e o que ainda pode melhorar.
        </p>
      </div>
    </div>
    <ProjectGallery projects={projects} locale="pt" />
  </section>
  <BlogPreview posts={posts} locale="pt" />
  <section id="about" class="shell section about-summary">
    <div>
      <h2>Sobre mim</h2>
    </div>
    <div>
      <p>
        No trabalho, desenvolvo aplicações empresariais com Java e Spring Boot.
        Procuro entender os compromissos de cada decisão e manter a arquitetura
        simples o suficiente para que o software possa evoluir.
      </p>
      <p>
        Nos projetos pessoais e acadêmicos, exploro novas ferramentas e
        abordagens. Uso esses projetos para investigar problemas além das
        demandas do dia a dia. Tenho inglês C1.
      </p>
      <a class="text-link" href="https://www.linkedin.com/in/erick-murakami">
        LinkedIn ↗
      </a>
    </div>
  </section>
  <section id="contact" class="shell contact-banner">
    <h2>Entre em contato</h2>
    <a class="button primary" href="https://www.linkedin.com/in/erick-murakami">
      LinkedIn <Icon />
    </a>
    <div class="resume-links">
      <a class="text-link" href="/resume/erick-murakami-resume-en.pdf" download>
        Resume · English ↓
      </a>
      <a
        class="text-link"
        href="/resume/erick-murakami-curriculo-pt.pdf"
        download
      >
        Currículo · Português ↓
      </a>
    </div>
  </section>
</Layout>
