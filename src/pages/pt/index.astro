---
import AboutSection from "../../components/AboutSection.astro";
import ContactSection from "../../components/ContactSection.astro";
import Certifications from "../../components/Certifications.astro";
import { getPublishedCertifications } from "../../lib/certifications";
import Layout from "../../layouts/Layout.astro";
import ProjectGallery from "../../components/ProjectGallery.astro";
import TechLabel from "../../components/TechLabel.astro";
import Icon from "../../components/Icon.astro";
import ExpertiseGrid from "../../components/ExpertiseGrid.astro";
import BlogPreview from "../../components/BlogPreview.astro";
import { getPublishedPosts } from "../../lib/blog";
import { getCollection } from "astro:content";
const projects = (await getCollection("projectsPt")).sort(
  (a, b) => a.data.order - b.data.order,
);
const certifications = await getPublishedCertifications("pt");
const posts = await getPublishedPosts("pt");
---

<Layout title="Engenheiro de Software Back-end">
  <section class="expertise-showcase" data-expertise-showcase>
    <div class="showcase-sticky">
      <div class="shell hero">
        <div class="hero-copy">
          <h1>
            Erick Murakami
            <span class="role">
              Engenheiro de Software{" "}
              <span class="nowrap">
                Back-end<span class="blue">.</span>
              </span>
            </span>
          </h1>

          <p class="intro">
            Desenvolvo sistemas backend em Java com foco em confiabilidade,
            arquitetura, desempenho e manutenção.
          </p>
          <div class="actions">
            <a class="button primary" href="/pt/#projects">
              Ver projetos <span aria-hidden="true">→</span>
            </a>
            <a class="button" href="https://github.com/ErickMurakami">
              GitHub <Icon />
            </a>
            <a class="button" href="https://www.linkedin.com/in/erick-murakami">
              LinkedIn <Icon />
            </a>
          </div>
          <a
            class="text-link hero-resume"
            href="/resume/erick-murakami-curriculo-pt.pdf"
            download
          >
            Baixar currículo ↓
          </a>
        </div>
        <ExpertiseGrid locale="pt" />
      </div>
      <div class="specialty-strip">
        <div class="shell">
          <span>TECNOLOGIAS</span>
          <strong>
            <TechLabel name="Java" />
          </strong>
          <strong>
            <TechLabel name="Quarkus" />
          </strong>
          <strong>
            <TechLabel name="Spring Boot" />
          </strong>
          <strong>
            <TechLabel name="PostgreSQL" />
          </strong>
          <strong>
            <TechLabel name="Docker" />
          </strong>
          <strong>
            <TechLabel name="LangChain4j" />
          </strong>
        </div>
      </div>
      <section id="projects" class="shell section">
        <div class="section-heading">
          <div>
            <h2>Projetos</h2>
            <p>
              O que fiz em cada projeto, como funciona e o que ainda pode
              melhorar.
            </p>
          </div>
          <a class="text-link" href="/pt/projects/">
            Ver todos os projetos →
          </a>
        </div>
        <ProjectGallery projects={projects} locale="pt" portion="lead" />
      </section>
    </div>
  </section>
  <div class="shell project-continuation">
    <ProjectGallery projects={projects} locale="pt" portion="continuation" />
  </div>
  <BlogPreview posts={posts} locale="pt" />
  <Certifications entries={certifications} locale="pt" />
  <AboutSection locale="pt" />
  <ContactSection locale="pt" />
</Layout>
