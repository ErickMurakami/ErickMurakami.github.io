---
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import Icon from "../../components/Icon.astro";
import { getCollection } from "astro:content";
const projects = (await getCollection("projectsPt")).sort(
  (a, b) => a.data.order - b.data.order,
);
const notes = (await getCollection("notesPt"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<Layout title="Engenheiro de Software Back-end">
  <section class="shell hero">
    <div class="hero-copy">
      <p class="eyebrow hero-label">
        <span class="dot" /> ECOSSISTEMA JAVA · ENGENHARIA BACKEND
      </p>
      <h1>
        Erick Murakami
        <span class="role">
          Engenheiro
          <br />
          de Software Back-end<span class="blue">.</span>
        </span>
      </h1>
      <p class="intro">
        Desenvolvo sistemas backend com foco em APIs claras, arquitetura
        sustentável e decisões que tornam o software confiável.
      </p>
      <div class="actions">
        <a class="button primary" href="/pt/projects/">
          Conheça meu trabalho <span aria-hidden="true">→</span>
        </a>
        <a class="button" href="https://github.com/ErickMurakami">
          GitHub <Icon />
        </a>
        <a class="button" href="https://www.linkedin.com/in/erick-murakami">
          LinkedIn <Icon />
        </a>
        <a
          class="button"
          href="/resume/erick-murakami-curriculo-pt.pdf"
          download
        >
          Baixar currículo ↓
        </a>
      </div>
      <p class="hero-caption">Java · Quarkus · Spring Boot · PostgreSQL</p>
    </div>
    <div
      class="architecture"
      aria-label="Foco de engenharia: contratos de API, regras de domínio e persistência"
    >
      <div class="diagram-header">
        <span class="dot" /> ENGENHARIA, DE DENTRO PARA FORA
      </div>
      <div class="diagram-line">
        <span>01</span>
        <Icon name="globe" />
        <div>
          <strong>Contratos claros</strong>
          <small>APIs REST e integrações</small>
        </div>
      </div>
      <div class="connector"></div>
      <div class="diagram-line core">
        <span>02</span>
        <Icon name="code" />
        <div>
          <strong>Domínio bem estruturado</strong>
          <small>Regras, limites e compromissos</small>
        </div>
        <span class="core-label">NÚCLEO</span>
      </div>
      <div class="connector"></div>
      <div class="diagram-line">
        <span>03</span>
        <Icon name="layers" />
        <div>
          <strong>Fundamentos sólidos</strong>
          <small>Persistência, testes e observabilidade</small>
        </div>
      </div>
      <div class="diagram-footer">
        <span>CONTRATO → DOMÍNIO → DADOS</span>
        <span aria-hidden="true">↗</span>
      </div>
    </div>
  </section>
  <div class="specialty-strip">
    <div class="shell">
      <span>CONSTRUÍDO NO ECOSSISTEMA JVM</span>
      <strong>Java</strong>
      <strong>Quarkus</strong>
      <strong>Spring Boot</strong>
      <strong>PostgreSQL</strong>
      <strong>Docker</strong>
    </div>
  </div>
  <section class="shell section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / PROJETOS SELECIONADOS</p>
        <h2>Código com decisões por trás.</h2>
        <p>
          Um olhar sobre os problemas, escolhas de implementação e compromissos
          técnicos.
        </p>
      </div>
      <a class="text-link" href="/pt/projects/">
        Todos os projetos <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="project-grid">
      {projects.map((p) => (
        <ProjectCard project={p} locale="pt" />
      ))}
    </div>
  </section>
  <section class="philosophy">
    <div class="shell section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">02 / ABORDAGEM DE ENGENHARIA</p>
          <h2>Construa pensando na próxima decisão.</h2>
        </div>
      </div>
      <div class="principles">
        <article>
          <span>01</span>
          <h3>Explicite as responsabilidades.</h3>
          <p>
            Mantenha contratos de API, regras de domínio e responsabilidades de
            persistência claros o bastante para analisá-los de forma
            independente.
          </p>
        </article>
        <article>
          <span>02</span>
          <h3>Entenda os compromissos.</h3>
          <p>
            Escolha uma ferramenta pela sua adequação ao problema. Descreva os
            custos com o mesmo cuidado dedicado aos benefícios.
          </p>
        </article>
        <article>
          <span>03</span>
          <h3>Siga as evidências.</h3>
          <p>
            Use código e testes relevantes para explicar o comportamento. Trate
            desempenho não medido como uma questão em aberto.
          </p>
        </article>
      </div>
    </div>
  </section>
  <section class="shell section writing">
    <div>
      <p class="eyebrow">03 / NOTAS TÉCNICAS</p>
      <h2>Espaço para aprofundar ideias.</h2>
      <p>
        Detalhes de implementação, questões de arquitetura e aprendizados da
        prática.
      </p>
    </div>
    <div class="notes-preview">
      {notes.length ? (
        notes.map((n) => <a href={`/pt/notes/${n.id}/`}>{n.data.title} →</a>)
      ) : (
        <>
          <span class="small-label">O CADERNO ESTÁ ABERTO</span>
          <p>
            Ainda não há artigos publicados. Por enquanto, explore as decisões
            técnicas documentadas nos estudos de caso.
          </p>
          <a class="text-link" href="/pt/notes/">
            Ver notas técnicas →
          </a>
        </>
      )}
    </div>
  </section>
  <section class="shell contact-banner">
    <p class="eyebrow">VAMOS CONVERSAR</p>
    <h2>
      Bons sistemas começam
      <br />
      com uma conversa.
    </h2>
    <a class="button primary" href="/pt/contact/">
      Entre em contato <Icon />
    </a>
  </section>
</Layout>
