---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
const notes = (await getCollection("notes")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Layout title="Engineering Notes">
  <section class="shell section">
    <div class="page-intro">
      <p class="eyebrow">THE ENGINEERING NOTEBOOK</p>
      <h1>
        Ideas worth
        <br />
        <span class="blue">working through.</span>
      </h1>
      <p>
        Notes on Java, backend architecture, and the lessons behind
        implementation choices.
      </p>
    </div>
    {notes.length ? (
      <div class="project-grid">
        {notes.map((n) => (
          <article class="project-card">
            <p class="eyebrow">
              {n.data.category} · {n.data.date.toISOString().slice(0, 10)}
            </p>
            <h2>
              <a href={`/notes/${n.id}/`}>{n.data.title}</a>
            </h2>
            <p>{n.data.description}</p>
          </article>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <span class="small-label">NO ARTICLES PUBLISHED YET</span>
        <h2>Thoughtful writing takes time.</h2>
        <p>
          The project case studies already document real architecture decisions
          and their limitations.
        </p>
        <a class="button" href="/projects/">
          Read the case studies →
        </a>
      </div>
    )}
  </section>
</Layout>
