---
import Layout from "../layouts/Layout.astro";
import ProjectGallery from "../components/ProjectGallery.astro";
import TechLabel from "../components/TechLabel.astro";
import Icon from "../components/Icon.astro";
import BlogPreview from "../components/BlogPreview.astro";
import { getPublishedPosts } from "../lib/blog";
import { getCollection } from "astro:content";
const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const posts = await getPublishedPosts("en");
---

<Layout title="Back-end Software Engineer">
  <section class="shell hero">
    <div class="hero-copy">
      <p class="eyebrow hero-label">
        <span class="dot" /> JAVA ECOSYSTEM · BACKEND ENGINEERING
      </p>
      <h1>
        Erick Murakami
        <span class="role">
          Back-end
          <br />
          Software Engineer<span class="blue">.</span>
        </span>
      </h1>
      <p class="intro">
        I develop APIs and backend applications in Java, using Quarkus and
        Spring Boot.
      </p>
      <div class="actions">
        <a class="button primary" href="/#projects">
          View projects <span aria-hidden="true">→</span>
        </a>
        <a class="button" href="https://github.com/ErickMurakami">
          GitHub <Icon />
        </a>
        <a class="button" href="https://www.linkedin.com/in/erick-murakami">
          LinkedIn <Icon />
        </a>
        <a class="button" href="/resume/erick-murakami-resume-en.pdf" download>
          Download resume ↓
        </a>
      </div>
      <p class="hero-caption">Java · Quarkus · Spring Boot · PostgreSQL</p>
    </div>
    <div
      class="architecture"
      aria-label="Engineering focus: API contracts, domain rules and persistence"
    >
      <div class="diagram-header">
        <span class="dot" /> API, DOMAIN AND DATA
      </div>
      <div class="diagram-line">
        <span>01</span>
        <Icon name="globe" />
        <div>
          <strong>API</strong>
          <small>Endpoints and integrations</small>
        </div>
      </div>
      <div class="connector"></div>
      <div class="diagram-line core">
        <span>02</span>
        <Icon name="code" />
        <div>
          <strong>Business rules</strong>
          <small>Validation and operations</small>
        </div>
        <span class="core-label">CORE</span>
      </div>
      <div class="connector"></div>
      <div class="diagram-line">
        <span>03</span>
        <Icon name="layers" />
        <div>
          <strong>Data</strong>
          <small>Databases and tests</small>
        </div>
      </div>
      <div class="diagram-footer">
        <span>CONTRACT → DOMAIN → DATA</span>
        <span aria-hidden="true">↗</span>
      </div>
    </div>
  </section>
  <div class="specialty-strip">
    <div class="shell">
      <span>TECHNOLOGIES</span>
      <strong>
        <TechLabel name="Java" />
      </strong>
      <strong>
        <TechLabel name="Quarkus" />
      </strong>
      <strong>
        <TechLabel name="Spring Boot" />
      </strong>
      <strong>
        <TechLabel name="PostgreSQL" />
      </strong>
      <strong>
        <TechLabel name="Docker" />
      </strong>
    </div>
  </div>
  <section id="projects" class="shell section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">PROJECTS</p>
        <h2>Projects</h2>
        <p>What each project does, how it works, and what I’d change.</p>
      </div>
    </div>
    <ProjectGallery projects={projects} locale="en" />
  </section>
  <BlogPreview posts={posts} locale="en" />
  <section id="about" class="shell section about-summary">
    <div>
      <p class="eyebrow">ABOUT</p>
      <h2>About me</h2>
    </div>
    <div>
      <p>
        I’m Erick, a backend engineer working with Java, Spring Boot and
        Quarkus. I’m interested in API design, databases and distributed
        systems.
      </p>
      <p>
        These projects cover personal finance, delivery orders, rate limiting
        and multitenancy. Each case study explains the implementation, its
        choices and its limitations.
      </p>
      <a class="text-link" href="https://www.linkedin.com/in/erick-murakami">
        LinkedIn ↗
      </a>
    </div>
  </section>
  <section id="contact" class="shell contact-banner">
    <p class="eyebrow">CONTACT</p>
    <h2>Get in touch</h2>
    <a class="button primary" href="https://www.linkedin.com/in/erick-murakami">
      LinkedIn <Icon />
    </a>
    <div class="resume-links">
      <a class="text-link" href="/resume/erick-murakami-resume-en.pdf" download>
        Resume · English ↓
      </a>
      <a
        class="text-link"
        href="/resume/erick-murakami-curriculo-pt.pdf"
        download
      >
        Currículo · Português ↓
      </a>
    </div>
  </section>
</Layout>
