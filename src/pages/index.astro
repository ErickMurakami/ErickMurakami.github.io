---
import Layout from "../layouts/Layout.astro";
import ProjectGallery from "../components/ProjectGallery.astro";
import TechLabel from "../components/TechLabel.astro";
import Icon from "../components/Icon.astro";
import { getCollection } from "astro:content";
const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const notes = (await getCollection("notes"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<Layout title="Back-end Software Engineer">
  <section class="shell hero">
    <div class="hero-copy">
      <p class="eyebrow hero-label">
        <span class="dot" /> JAVA ECOSYSTEM · BACKEND ENGINEERING
      </p>
      <h1>
        Erick Murakami
        <span class="role">
          Back-end
          <br />
          Software Engineer<span class="blue">.</span>
        </span>
      </h1>
      <p class="intro">
        I build backend systems with a focus on clear APIs, maintainable
        architecture, and the decisions that make software reliable.
      </p>
      <div class="actions">
        <a class="button primary" href="/#projects">
          Explore my work <span aria-hidden="true">→</span>
        </a>
        <a class="button" href="https://github.com/ErickMurakami">
          GitHub <Icon />
        </a>
        <a class="button" href="https://www.linkedin.com/in/erick-murakami">
          LinkedIn <Icon />
        </a>
        <a class="button" href="/resume/erick-murakami-resume-en.pdf" download>
          Download resume ↓
        </a>
      </div>
      <p class="hero-caption">Java · Quarkus · Spring Boot · PostgreSQL</p>
    </div>
    <div
      class="architecture"
      aria-label="Engineering focus: API contracts, domain rules and persistence"
    >
      <div class="diagram-header">
        <span class="dot" /> ENGINEERING, FROM THE INSIDE OUT
      </div>
      <div class="diagram-line">
        <span>01</span>
        <Icon name="globe" />
        <div>
          <strong>Clear contracts</strong>
          <small>REST APIs & integrations</small>
        </div>
      </div>
      <div class="connector"></div>
      <div class="diagram-line core">
        <span>02</span>
        <Icon name="code" />
        <div>
          <strong>Thoughtful domain logic</strong>
          <small>Rules, boundaries & trade-offs</small>
        </div>
        <span class="core-label">CORE</span>
      </div>
      <div class="connector"></div>
      <div class="diagram-line">
        <span>03</span>
        <Icon name="layers" />
        <div>
          <strong>Dependable foundations</strong>
          <small>Persistence, tests & observability</small>
        </div>
      </div>
      <div class="diagram-footer">
        <span>CONTRACT → DOMAIN → DATA</span>
        <span aria-hidden="true">↗</span>
      </div>
    </div>
  </section>
  <div class="specialty-strip">
    <div class="shell">
      <span>BUILT AROUND THE JVM</span>
      <strong>
        <TechLabel name="Java" />
      </strong>
      <strong>
        <TechLabel name="Quarkus" />
      </strong>
      <strong>
        <TechLabel name="Spring Boot" />
      </strong>
      <strong>
        <TechLabel name="PostgreSQL" />
      </strong>
      <strong>
        <TechLabel name="Docker" />
      </strong>
    </div>
  </div>
  <section id="projects" class="shell section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / SELECTED WORK</p>
        <h2>Code with a reason behind it.</h2>
        <p>
          A closer look at the problems, implementation choices, and trade-offs.
        </p>
      </div>
    </div>
    <ProjectGallery projects={projects} locale="en" />
  </section>
  <section class="philosophy">
    <div class="shell section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">02 / ENGINEERING APPROACH</p>
          <h2>Build for the next decision.</h2>
        </div>
      </div>
      <div class="principles">
        <article>
          <span>01</span>
          <h3>Make boundaries explicit.</h3>
          <p>
            Keep API contracts, domain rules, and persistence responsibilities
            clear enough to reason about independently.
          </p>
        </article>
        <article>
          <span>02</span>
          <h3>Understand the trade-off.</h3>
          <p>
            Choose a tool because it fits the problem. Describe the costs as
            carefully as the benefits.
          </p>
        </article>
        <article>
          <span>03</span>
          <h3>Let evidence lead.</h3>
          <p>
            Use source code and meaningful tests to explain behavior. Treat
            unmeasured performance as an open question.
          </p>
        </article>
      </div>
    </div>
  </section>
  {notes.length > 0 && (
    <>
      <section id="notes" class="shell section writing">
        <div>
          <p class="eyebrow">03 / ENGINEERING NOTES</p>
          <h2>Space for deeper thinking.</h2>
          <p>
            Implementation details, architectural questions, and lessons from
            building.
          </p>
        </div>
        <div class="notes-preview">
          {notes.length ? (
            notes.map((n) => <a href={`/notes/${n.id}/`}>{n.data.title} →</a>)
          ) : (
            <>
              <span class="small-label">THE NOTEBOOK IS OPEN</span>
              <p>
                No articles published yet. For now, explore the technical
                decisions documented in the project case studies.
              </p>
              <a class="text-link" href="/#notes">
                Visit engineering notes →
              </a>
            </>
          )}
        </div>
      </section>
    </>
  )}
  <section id="about" class="shell section about-summary">
    <div>
      <p class="eyebrow">03 / ABOUT</p>
      <h2>Engineering with context.</h2>
    </div>
    <div>
      <p>
        I’m a back-end software engineer focused on Java, Spring Boot and
        Quarkus. I explore API design, distributed systems and architectural
        decisions that keep software maintainable.
      </p>
      <p>
        My personal projects turn these questions into concrete implementations:
        financial workflows, request limits, order lifecycles and tenant
        isolation.
      </p>
      <a class="text-link" href="https://www.linkedin.com/in/erick-murakami">
        LinkedIn ↗
      </a>
    </div>
  </section>
  <section id="contact" class="shell contact-banner">
    <p class="eyebrow">LET’S CONNECT</p>
    <h2>
      Good systems start
      <br />
      with a conversation.
    </h2>
    <a class="button primary" href="https://www.linkedin.com/in/erick-murakami">
      Get in touch <Icon />
    </a>
    <div class="resume-links">
      <a class="text-link" href="/resume/erick-murakami-resume-en.pdf" download>
        Resume · English ↓
      </a>
      <a
        class="text-link"
        href="/resume/erick-murakami-curriculo-pt.pdf"
        download
      >
        Currículo · Português ↓
      </a>
    </div>
  </section>
</Layout>
