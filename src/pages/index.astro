---
import AboutSection from "../components/AboutSection.astro";
import ContactSection from "../components/ContactSection.astro";
import Certifications from "../components/Certifications.astro";
import { getPublishedCertifications } from "../lib/certifications";
import LearningSection from "../components/LearningSection.astro";
import Layout from "../layouts/Layout.astro";
import ProjectGallery from "../components/ProjectGallery.astro";
import TechLabel from "../components/TechLabel.astro";
import Icon from "../components/Icon.astro";
import ExpertiseGrid from "../components/ExpertiseGrid.astro";
import BlogPreview from "../components/BlogPreview.astro";
import { getPublishedPosts } from "../lib/blog";
import { getCollection } from "astro:content";
const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const certifications = await getPublishedCertifications("en");
const posts = await getPublishedPosts("en");
---

<Layout title="Backend Software Engineer">
  <section class="expertise-showcase" data-expertise-showcase>
    <div class="showcase-sticky">
      <div class="shell hero">
        <div class="hero-copy">
          <h1>
            Erick Murakami
            <span class="role">
              Backend Software Engineer<span class="blue">.</span>
            </span>
          </h1>

          <p class="intro">
            Building reliable Java backend systems with a focus on architecture,
            performance, and maintainability.
          </p>
          <div class="actions">
            <a class="button primary" href="/#projects">
              View projects <span aria-hidden="true">→</span>
            </a>
            <a class="button" href="https://github.com/ErickMurakami">
              GitHub <Icon />
            </a>
            <a class="button" href="https://www.linkedin.com/in/erick-murakami">
              LinkedIn <Icon />
            </a>
          </div>
          <a
            class="text-link hero-resume"
            href="/resume/erick-murakami-resume-en.pdf"
            download
          >
            Download resume ↓
          </a>
        </div>
        <ExpertiseGrid locale="en" />
      </div>
      <div class="specialty-strip">
        <div class="shell">
          <span>TECHNOLOGIES</span>
          <strong>
            <TechLabel name="Java" />
          </strong>
          <strong>
            <TechLabel name="Quarkus" />
          </strong>
          <strong>
            <TechLabel name="Spring Boot" />
          </strong>
          <strong>
            <TechLabel name="PostgreSQL" />
          </strong>
          <strong>
            <TechLabel name="Docker" />
          </strong>
          <strong>
            <TechLabel name="LangChain4j" />
          </strong>
        </div>
      </div>
      <section id="projects" class="shell section">
        <div class="section-heading">
          <div>
            <h2>Projects</h2>
            <p>What each project does, how it works, and what I’d change.</p>
          </div>
          <a class="text-link" href="/projects/">
            View all projects →
          </a>
        </div>
        <ProjectGallery projects={projects} locale="en" portion="lead" />
      </section>
    </div>
  </section>
  <div class="shell project-continuation">
    <ProjectGallery projects={projects} locale="en" portion="continuation" />
  </div>
  <BlogPreview posts={posts} locale="en" />
  <Certifications entries={certifications} locale="en" />
  <LearningSection locale="en" />
  <AboutSection locale="en" />
  <ContactSection locale="en" />
</Layout>
