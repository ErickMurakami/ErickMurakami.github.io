---
import Layout from "../layouts/Layout.astro";
import ProjectGallery from "../components/ProjectGallery.astro";
import TechLabel from "../components/TechLabel.astro";
import Icon from "../components/Icon.astro";
import ExpertiseGrid from "../components/ExpertiseGrid.astro";
import BlogPreview from "../components/BlogPreview.astro";
import { getPublishedPosts } from "../lib/blog";
import { getCollection } from "astro:content";
const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const posts = await getPublishedPosts("en");
---

<Layout title="Backend Software Engineer">
  <section class="expertise-showcase" data-expertise-showcase>
    <div class="showcase-sticky">
      <div class="shell hero">
        <div class="hero-copy">
          <h1>
            Erick Murakami
            <span class="role">
              Backend Software Engineer<span class="blue">.</span>
            </span>
          </h1>

          <p class="intro">
            Building reliable Java backend systems with a focus on architecture,
            performance, and maintainability.
          </p>
          <div class="actions">
            <a class="button primary" href="/#projects">
              View projects <span aria-hidden="true">→</span>
            </a>
            <a class="button" href="https://github.com/ErickMurakami">
              GitHub <Icon />
            </a>
            <a class="button" href="https://www.linkedin.com/in/erick-murakami">
              LinkedIn <Icon />
            </a>
          </div>
          <a
            class="text-link hero-resume"
            href="/resume/erick-murakami-resume-en.pdf"
            download
          >
            Download resume ↓
          </a>
        </div>
        <ExpertiseGrid locale="en" />
      </div>
      <div class="specialty-strip">
        <div class="shell">
          <span>TECHNOLOGIES</span>
          <strong>
            <TechLabel name="Java" />
          </strong>
          <strong>
            <TechLabel name="Quarkus" />
          </strong>
          <strong>
            <TechLabel name="Spring Boot" />
          </strong>
          <strong>
            <TechLabel name="PostgreSQL" />
          </strong>
          <strong>
            <TechLabel name="Docker" />
          </strong>
        </div>
      </div>
    </div>
  </section>
  <section id="projects" class="shell section">
    <div class="section-heading">
      <div>
        <h2>Projects</h2>
        <p>What each project does, how it works, and what I’d change.</p>
      </div>
    </div>
    <ProjectGallery projects={projects} locale="en" />
  </section>
  <BlogPreview posts={posts} locale="en" />
  <section id="about" class="shell section about-summary">
    <div>
      <h2>About me</h2>
    </div>
    <div>
      <p>
        In my professional work, I develop enterprise applications with Java and
        Spring Boot. I care about understanding trade-offs and keeping
        architecture simple enough for the software to evolve.
      </p>
      <p>
        Personal and academic projects give me room to explore new tools and
        approaches beyond day-to-day requirements. My English proficiency is C1.
      </p>
      <a class="text-link" href="https://www.linkedin.com/in/erick-murakami">
        LinkedIn ↗
      </a>
    </div>
  </section>
  <section id="contact" class="shell contact-banner">
    <h2>Get in touch</h2>
    <a class="button primary" href="https://www.linkedin.com/in/erick-murakami">
      LinkedIn <Icon />
    </a>
    <div class="resume-links">
      <a class="text-link" href="/resume/erick-murakami-resume-en.pdf" download>
        Resume · English ↓
      </a>
      <a
        class="text-link"
        href="/resume/erick-murakami-curriculo-pt.pdf"
        download
      >
        Currículo · Português ↓
      </a>
    </div>
  </section>
</Layout>
