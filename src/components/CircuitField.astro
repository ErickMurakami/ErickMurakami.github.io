---
const waveHeights = [20, 36, 60, 88, 112, 74, 42, 96, 132, 110, 62, 32, 70, 48, 24];
---

<div class="circuit-field" aria-hidden="true">
  <svg viewBox="0 0 1200 500" preserveAspectRatio="xMaxYMid slice" fill="none">
    <defs>
      <pattern id="circuit-grid" width="30" height="30" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r="1" fill="currentColor" opacity=".22" /></pattern>
    </defs>
    <rect width="1200" height="500" fill="url(#circuit-grid)" />
    <g class="circuit-traces" stroke="currentColor">
      <path d="M0 100H180L260 180H680L750 250H930L1000 320H1200" />
      <path d="M80 500V380L200 260H750V250H930V120L1000 50H1200" />
      <path d="M320 0V60L440 180H750V250H840V390L930 480H1200" />
      <path d="M0 430H270L350 350V250H750V180H1040L1120 100H1200" />
    </g>
    <g class="circuit-signals" stroke="currentColor" stroke-width="2" pathLength="100">
      <path pathLength="100" d="M0 100H180L260 180H680L750 250H930L1000 320H1200" />
      <path pathLength="100" d="M80 500V380L200 260H750V250H930V120L1000 50H1200" />
      <path pathLength="100" d="M320 0V60L440 180H750V250H840V390L930 480H1200" />
    </g>
    <g class="circuit-nodes" fill="var(--background)" stroke="currentColor">
      <rect x="725" y="225" width="50" height="50" rx="3" />
      <rect x="736" y="236" width="28" height="28" rx="1" />
      <circle cx="180" cy="100" r="5" /><circle cx="930" cy="120" r="5" />
      <circle cx="840" cy="390" r="5" /><circle cx="1000" cy="320" r="5" />
      <circle cx="270" cy="430" r="4" /><circle cx="1040" cy="180" r="4" />
    </g>
    <g class="circuit-wave-frame" stroke="currentColor">
      <path d="M775 250h35M1150 250h50M810 190v-26h36M1114 164h36v26M810 310v26h36M1114 336h36v-26" />
      <path d="M820 250h320" stroke-dasharray="2 8" opacity=".35" />
    </g>
    <g class="circuit-wave" fill="currentColor">
      {waveHeights.map((height, index) => (
        <rect x={828 + index * 21} y={250 - height / 2} width="5" height={height} rx="2.5" style={`--bar: ${index}`} />
      ))}
    </g>
  </svg>
</div>
