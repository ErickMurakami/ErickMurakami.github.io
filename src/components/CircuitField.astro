---
const bars = Array.from({ length: 61 }, (_, index) => {
  const x = index * 20;
  const envelope = Math.exp(-Math.pow((x - 850) / 310, 2));
  const rhythm = .45 + .55 * Math.pow(Math.sin(index * .67 + .4), 2);
  const height = 16 + 190 * envelope * rhythm;
  return { x, height };
});
// Short connections attach to bar centres, which stay fixed as the waveform pulses.
const connections = ["M620 250h24l20-20h36", "M900 250h24l20 20h36", "M1040 250h20l16-16h24"];
const nodes = [[620, 250], [700, 230], [900, 250], [980, 270], [1040, 250], [1100, 234]];
---

<div class="circuit-field" aria-hidden="true" transition:persist="home-music-field" transition:animate="none">
  <svg viewBox="0 0 1200 500" preserveAspectRatio="xMaxYMid slice" fill="none">
    <defs>
      <pattern id="circuit-grid" width="40" height="40" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r=".8" fill="currentColor" opacity=".1" /></pattern>
    </defs>
    <rect width="1200" height="500" fill="url(#circuit-grid)" />
    <g class="circuit-weave">
      <g class="circuit-traces" stroke="currentColor">
        <path d="M0 250h1200" opacity=".35" />
        {connections.map((d) => <path d={d} />)}
      </g>
      <g class="circuit-wave" stroke="currentColor" stroke-width="5" stroke-linecap="round">
        <g class="wave-scroll-response">
          {bars.map(({ x, height }, index) => <path d={`M${x} ${250 - height / 2}v${height}`} style={`--channel: ${index}`} />)}
        </g>
      </g>
      <g class="circuit-signals" stroke="currentColor" stroke-width="1">
        {connections.map((d) => <path d={d} pathLength="100" />)}
      </g>
      <g class="circuit-nodes" fill="var(--background)" stroke="currentColor">
        {nodes.map(([cx, cy]) => <circle cx={cx} cy={cy} r="2.5" />)}
      </g>
    </g>
  </svg>
</div>
