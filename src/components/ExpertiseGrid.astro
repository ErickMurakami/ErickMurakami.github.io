---
interface Props {
  locale: "en" | "pt";
}
const pt = Astro.props.locale === "pt";
const cards = pt
  ? [
      {
        title: "Backend empresarial",
        label: "Experiência profissional",
        text: "Java e Spring Boot em aplicações com APIs REST, multitenancy, bancos relacionais e integrações com serviços externos.",
      },
      {
        title: "Arquitetura backend",
        label: "Decisões de engenharia",
        text: "Clean Architecture, Domain-Driven Design e os compromissos de cada abordagem. Estruturas que acompanhem a evolução do software sem complexidade desnecessária.",
      },
      {
        title: "Engenharia de IA",
        label: "Projetos pessoais e acadêmicos",
        text: "Exploração de integração com LLMs, agentes e MCP com Spring AI, LangChain4j, Quarkus e Python.",
      },
      {
        title: "Além da JVM",
        label: "Escolha de ferramentas",
        text: "Exploração de Python e tecnologias fora do Java quando elas se ajustam melhor ao problema. A escolha parte dos requisitos e das limitações de cada solução.",
      },
    ]
  : [
      {
        title: "Enterprise Backend",
        label: "Professional experience",
        text: "Java and Spring Boot applications with REST APIs, multi-tenant systems, relational databases and external service integrations.",
      },
      {
        title: "Backend Architecture",
        label: "Engineering decisions",
        text: "Clean Architecture, Domain-Driven Design and the trade-offs behind each approach. Structures that let software evolve without unnecessary complexity.",
      },
      {
        title: "AI Engineering",
        label: "Personal and academic projects",
        text: "Exploring LLM integration, agents and MCP with Spring AI, LangChain4j, Quarkus and Python.",
      },
      {
        title: "Beyond the JVM",
        label: "Tool selection",
        text: "Exploring Python and technologies outside Java when they fit the problem better. Requirements and the limitations of each solution guide that choice.",
      },
    ];
---

<section
  class="expertise"
  aria-label={pt ? "Atuação e interesses" : "Work and interests"}
>
  <div class="expertise-grid">
    {cards.map((card) => (
      <article class="expertise-card">
        <p class="expertise-label">{card.label}</p>
        <h2>{card.title}</h2>
        <p>{card.text}</p>
      </article>
    ))}
  </div>
  <div class="expertise-progress" aria-hidden="true">
    {cards.map((card, index) => (
      <span
        class:list={["expertise-mark", { "is-active": index === 0 }]}
        title={card.title}
      />
    ))}
  </div>
</section>
<script>
  const section = document.querySelector<HTMLElement>(
    "[data-expertise-showcase]",
  );
  if (section) {
    const sticky = section.querySelector<HTMLElement>(".showcase-sticky")!;
    const cards = [...section.querySelectorAll<HTMLElement>(".expertise-card")];
    const marks = [...section.querySelectorAll<HTMLElement>(".expertise-mark")];
    const media = matchMedia(
      "(min-width: 1001px) and (prefers-reduced-motion: no-preference)",
    );
    let frame = 0;
    let visible = true;
    let active = -1;
    function update() {
      frame = 0;
      if (!visible || !section!.classList.contains("is-scroll-showcase"))
        return;
      const offset = parseFloat(
        section!.style.getPropertyValue("--showcase-top"),
      );
      const travel = section!.offsetHeight - sticky.offsetHeight;
      const progress = Math.max(
        0,
        Math.min(1, (offset - section!.getBoundingClientRect().top) / travel),
      );
      const index = Math.round(progress * (cards.length - 1));
      if (index === active) return;
      active = index;
      cards.forEach((card, i) =>
        card.classList.toggle("is-active", i === index),
      );
      marks.forEach((mark, i) =>
        mark.classList.toggle("is-active", i === index),
      );
      section!.dataset.activeCard = String(index);
    }
    function schedule() {
      if (!frame) frame = requestAnimationFrame(update);
    }
    function configure() {
      const top = document
        .querySelector(".header")!
        .getBoundingClientRect().height;
      section!.style.setProperty("--showcase-top", `${top}px`);
      section!.classList.toggle("is-scroll-showcase", media.matches);
      // Short screens use the static presentation instead of clipping the introduction.
      if (media.matches && sticky.offsetHeight > innerHeight - top - 12)
        section!.classList.remove("is-scroll-showcase");
      section!.style.setProperty(
        "--showcase-height",
        `${sticky.offsetHeight}px`,
      );
      section!.style.setProperty(
        "--showcase-travel",
        `${3 * Math.min(250, Math.max(180, innerHeight * 0.25))}px`,
      );
      schedule();
    }
    new IntersectionObserver((entries) => {
      visible = entries[0].isIntersecting;
      if (visible) schedule();
    }).observe(section);
    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", configure);
    media.addEventListener("change", configure);
    configure();
    document.fonts.ready.then(configure);
  }
</script>
