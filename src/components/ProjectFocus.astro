---
interface Props {
  locale: "en" | "pt";
}
const pt = Astro.props.locale === "pt";
const path = `${pt ? "/pt" : ""}/projects/econolyze/`;
const source =
  "https://github.com/ErickMurakami/Econolyze/blob/f849783/services/financial-service/src/main/java/dev/econolyze/application/services/TransactionService.java#L92-L123";
---

<aside class="project-focus" aria-labelledby="focus-project">
  <p class="eyebrow">{pt ? "POR DENTRO DO PROJETO" : "INSIDE THE PROJECT"}</p>
  <h2 id="focus-project">
    <a href={path}>Econolyze</a>
  </h2>
  <h3>
    {pt
      ? "Um pagamento também altera o saldo."
      : "A payment also changes the balance."}
  </h3>
  <div class="transaction-boundary">
    <p class="boundary-label">
      <span>{pt ? "Serviço financeiro" : "Financial service"}</span>
      <code>@WithTransaction</code>
    </p>
    <ol class="payment-flow">
      <li>
        <span class="flow-step" aria-hidden="true">
          1
        </span>
        <div>
          <strong>{pt ? "Registrar pagamento" : "Record payment"}</strong>
          <small>
            {pt
              ? "Associar à transação e recalcular o status"
              : "Attach to transaction and recalculate status"}
          </small>
        </div>
      </li>
      <li>
        <span class="flow-step" aria-hidden="true">
          2
        </span>
        <div>
          <strong>{pt ? "Persistir transação" : "Persist transaction"}</strong>
          <small>transactionRepository.persist</small>
        </div>
      </li>
      <li>
        <span class="flow-step" aria-hidden="true">
          3
        </span>
        <div>
          <strong>{pt ? "Atualizar saldo" : "Update balance"}</strong>
          <small>accountService.updateAccountBalance</small>
        </div>
      </li>
    </ol>
  </div>
  <p class="focus-limit">
    {pt
      ? "A fronteira está no código. Testes de rollback e alterações concorrentes de saldo ainda são melhorias necessárias."
      : "The boundary is in the code. Rollback and concurrent balance updates still need dedicated tests."}
  </p>
  <div class="focus-links">
    <a class="text-link" href={path}>
      {pt ? "Ler estudo de caso →" : "Read case study →"}
    </a>
    <a class="text-link" href={source}>
      {pt ? "Ver implementação ↗" : "View implementation ↗"}
    </a>
  </div>
</aside>
