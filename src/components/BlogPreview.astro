---
import type { CollectionEntry } from "astro:content";
interface Props {
  posts: (CollectionEntry<"notes"> | CollectionEntry<"notesPt">)[];
  locale: "en" | "pt";
}
const { posts, locale } = Astro.props;
const pt = locale === "pt";
const home = pt ? "/pt/" : "/";
---

{posts.length > 0 && (
  <div class="home-band home-band-writing">
    <section id="blog" class="shell section blog-preview">
      <div class="section-heading">
        <div>
          <p class="section-kicker"><span class="section-number" aria-hidden="true" />{pt ? "Artigos" : "Writing"}</p>
          <h2>{pt ? "Artigos" : "Articles"}</h2>
        </div>
        <a class="text-link" href={`${home}blog/`}>
          {pt ? "Ver todos os artigos →" : "All articles →"}
        </a>
      </div>
      <div class="post-list">
        {posts.slice(0, 3).map((post) => (
          <article class="post-item">
            <p class="post-meta">
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString(pt ? "pt-BR" : "en-GB", {
                  timeZone: "UTC",
                })}
              </time>{" "}
              · {post.data.category}
            </p>
            <h3>
              <a href={`${home}blog/${post.id}/`}>{post.data.title}</a>
            </h3>
            <p>{post.data.description}</p>
          </article>
        ))}
      </div>
    </section>
  </div>
)}
