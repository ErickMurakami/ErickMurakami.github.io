---
import type { CollectionEntry } from "astro:content";
import ProjectCard from "./ProjectCard.astro";
import TechLabel from "./TechLabel.astro";
import { githubProjects } from "../lib/projects";
interface Props {
  projects: (CollectionEntry<"projects"> | CollectionEntry<"projectsPt">)[];
  locale?: "en" | "pt";
  includeAdditional?: boolean;
}
const { projects, locale = "en", includeAdditional = true } = Astro.props;
const pt = locale === "pt";
const additional = githubProjects.filter(
  (repo) => !projects.some((project) => project.data.repo === repo.name),
);
---

<div class="project-grid">
  {projects.map((project) => (
    <ProjectCard project={project} locale={locale} />
  ))}
</div>
{includeAdditional && additional.length > 0 && (
  <div class="additional-projects">
    <h3>{pt ? "Mais projetos públicos" : "More projects"}</h3>
    <p>
      {pt
        ? "Outros repositórios, ainda sem estudo de caso."
        : "Other repositories, without a case study yet."}
    </p>
    <div class="project-grid">
      {additional.map((repo) => (
        <article class="project-card">
          <h3>
            <a href={repo.url} target="_blank" rel="noopener noreferrer">
              {repo.name}
            </a>
          </h3>
          <p>{repo.description}</p>
          {repo.language && (
            <ul class="tags">
              <li>
                <TechLabel name={repo.language} />
              </li>
            </ul>
          )}
          <a
            class="text-link"
            href={repo.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            {pt ? "Ver código no GitHub ↗" : "View source on GitHub ↗"}
          </a>
        </article>
      ))}
    </div>
  </div>
)}
