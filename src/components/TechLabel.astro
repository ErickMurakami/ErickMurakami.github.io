---
interface Props {
  name: string;
}
const { name } = Astro.props;
const normalized = name.toLowerCase();
const logos: Record<string, string> = {
  langchain4j: "langchain4j",
  java: "java",
  quarkus: "quarkus",
  spring: "spring",
  groq: "groq",
  spotify: "spotify",
  postgresql: "postgresql",
  docker: "docker",
  redis: "redis",
  rabbitmq: "rabbitmq",
  lua: "lua",
  hibernate: "hibernate",
  flyway: "flyway",
  opentelemetry: "opentelemetry",
  angular: "angular",
  php: "php",
  n8n: "n8n",
};
const key = Object.keys(logos).find((key) => normalized.startsWith(key));
---

<span class="tech-label">
  {key && (
    <img
      src={`/technologies/${logos[key]}.${key === "langchain4j" ? "png" : "svg"}`}
      alt=""
      width="22"
      height="22"
      loading="lazy"
      decoding="async"
    />
  )}
  <span>{name}</span>
</span>
