---
import { getCollection } from "astro:content";
interface Props {
  locale: "en" | "pt";
  standalone?: boolean;
}
const { locale, standalone = false } = Astro.props;
const pt = locale === "pt";
const entries = (
  await getCollection(
    "learning",
    (entry) => entry.data.locale === locale && !entry.data.draft,
  )
).sort((a, b) => a.data.order - b.data.order);
const Heading = standalone ? "h1" : "h2";
const GroupHeading = standalone ? "h2" : "h3";
const EntryHeading = standalone ? "h3" : "h4";
const groups = [
  { kind: "education", title: pt ? "Formação acadêmica" : "Education" },
  { kind: "course", title: pt ? "Cursos" : "Courses" },
];
---

<section id="courses" class="shell section">
  <div class="section-heading">
    <Heading>{pt ? "Formação e cursos" : "Education & courses"}</Heading>
    {!standalone && (
      <a class="text-link" href={`${pt ? "/pt" : ""}/courses/`}>
        {pt ? "Ver todos →" : "View all →"}
      </a>
    )}
  </div>
  <div class="post-list">
    {groups.map((group) => {
      const items = entries.filter((entry) => entry.data.kind === group.kind);
      return (
        items.length > 0 && (
          <div class="learning-group">
            <GroupHeading>{group.title}</GroupHeading>
            {items.map((entry) => (
              <article class="post-item">
                <p class="post-meta">
                  {entry.data.institution} · {entry.data.period}
                </p>
                <EntryHeading>{entry.data.title}</EntryHeading>
                {entry.data.location && <p>{entry.data.location}</p>}
              </article>
            ))}
          </div>
        )
      );
    })}
  </div>
</section>
