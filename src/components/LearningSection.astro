---
import { getCollection } from "astro:content";
interface Props {
  locale: "en" | "pt";
  standalone?: boolean;
  embedded?: boolean;
  headingLevel?: 2 | 3;
  compact?: boolean;
}
const {
  locale,
  standalone = false,
  embedded = false,
  headingLevel = 2,
  compact = false,
} = Astro.props;
const pt = locale === "pt";
const entries = (
  await getCollection(
    "learning",
    (entry) =>
      entry.data.kind === "education" &&
      entry.data.locale === locale &&
      !entry.data.draft,
  )
).sort((a, b) => a.data.order - b.data.order);
const Heading = embedded
  ? headingLevel === 2
    ? "h2"
    : "h3"
  : standalone
    ? "h1"
    : "h2";
const EntryHeading = embedded
  ? headingLevel === 2
    ? "h3"
    : "h4"
  : standalone
    ? "h2"
    : "h3";
---

<section id="courses" class={embedded ? "about-subsection" : "shell section"}>
  <div class="section-heading">
    <Heading>
      {standalone
        ? pt
          ? "Formação e cursos"
          : "Education & courses"
        : pt
          ? "Formação"
          : "Education"}
    </Heading>
  </div>
  <div class="post-list">
    {entries.map((entry) => {
      const Container = compact ? "details" : "div";
      const Summary = compact ? "summary" : "div";
      return (
        <article class="post-item education-entry">
          <Container
            class:list={["education-content", { "education-more": compact }]}
          >
            <Summary
              class="education-header"
              aria-label={
                compact
                  ? `${pt ? "Detalhes da formação" : "Education details"}: ${entry.data.title}`
                  : undefined
              }
            >
              <EntryHeading class="education-heading">
                <span class="post-meta">
                  {entry.data.institution} · {entry.data.period}
                </span>
                <span class="education-title">{entry.data.title}</span>
                {compact && (
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    aria-hidden="true"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                )}
              </EntryHeading>
            </Summary>
            <div class="education-details">
              {entry.data.location && <p>{entry.data.location}</p>}
              {entry.data.academicFocus && (
                <div class="education-background education-focus">
                  <span class="small-label">
                    {pt ? "FOCO ACADÊMICO" : "ACADEMIC FOCUS"}
                  </span>
                  {entry.data.academicFocus.map((paragraph) => (
                    <p class="education-project">{paragraph}</p>
                  ))}
                </div>
              )}
              {!!entry.data.background?.length && (
                <p class="education-background">
                  <span class="small-label">
                    {pt ? "BASE ACADÊMICA" : "ACADEMIC FOUNDATION"}
                  </span>
                  <br />
                  {entry.data.background.join(", ")}
                </p>
              )}
              {entry.data.finalProject && (
                <p class="education-project">{entry.data.finalProject}</p>
              )}
            </div>
          </Container>
        </article>
      );
    })}
  </div>
</section>
