---
import Icon from "./Icon.astro";
interface Props {
  locale: "en" | "pt";
  standalone?: boolean;
}
const { locale, standalone = false } = Astro.props;
const Heading = standalone ? "h1" : "h2";
---

{locale === "pt" ? (
  <section id="contact" class="shell contact-banner">
    <Heading>Entre em contato</Heading>
    <a class="button primary" href="https://www.linkedin.com/in/erick-murakami">
      LinkedIn <Icon />
    </a>
    <div class="resume-links">
      <a class="text-link" href="/resume/erick-murakami-resume-en.pdf" download>
        Resume · English ↓
      </a>
      <a
        class="text-link"
        href="/resume/erick-murakami-curriculo-pt.pdf"
        download
      >
        Currículo · Português ↓
      </a>
    </div>
  </section>
) : (
  <section id="contact" class="shell contact-banner">
    <Heading>Get in touch</Heading>
    <a class="button primary" href="https://www.linkedin.com/in/erick-murakami">
      LinkedIn <Icon />
    </a>
    <div class="resume-links">
      <a class="text-link" href="/resume/erick-murakami-resume-en.pdf" download>
        Resume · English ↓
      </a>
      <a
        class="text-link"
        href="/resume/erick-murakami-curriculo-pt.pdf"
        download
      >
        Currículo · Português ↓
      </a>
    </div>
  </section>
)}
