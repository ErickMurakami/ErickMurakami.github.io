---
import shapes from '../data/cursor-shapes.json';
---

<span class="drift-cursor" data-drift-cursor aria-hidden="true">
  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
    <path d={shapes.arrow} stroke-width="1" stroke-linejoin="miter" vector-effect="non-scaling-stroke" />
  </svg>
</span>
