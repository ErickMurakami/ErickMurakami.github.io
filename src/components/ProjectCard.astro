---
import type { CollectionEntry } from "astro:content";
import TechLabel from "./TechLabel.astro";
import Icon from "./Icon.astro";
interface Props {
  project: CollectionEntry<"projects"> | CollectionEntry<"projectsPt">;
  locale?: "en" | "pt";
}
const {
  project: { id, data: p },
} = Astro.props;
const pt = Astro.props.locale === "pt";
const projectPath = `${pt ? "/pt" : ""}/projects/${id}/`;
---

<article class="project-card" data-project={p.repo}>
  <p class="eyebrow">{p.focus}</p>
  <h3>
    <a href={projectPath}>{p.title}</a>
  </h3>
  <p class="card-description">{p.description}</p>
  <ul class="tags" aria-label={pt ? "Tecnologias" : "Technologies"}>
    {p.stack.map((t) => (
      <li>
        <TechLabel name={t} />
      </li>
    ))}
  </ul>
  <div class="card-links">
    <a href={projectPath}>
      {pt ? "Ler estudo de caso" : "Read case study"}{" "}
      <span aria-hidden="true">→</span>
    </a>
    <a
      href={`https://github.com/ErickMurakami/${p.repo}`}
      aria-label={`${p.title}: ${pt ? "código no GitHub" : "source on GitHub"}`}
      target="_blank"
      rel="noopener noreferrer"
    >
      <Icon name="code" />
    </a>
  </div>
</article>
