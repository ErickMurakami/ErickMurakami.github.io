---
import "../styles/global.css";
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-500.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/inter/latin-700.css";
import Icon from "../components/Icon.astro";
import { languagePaths } from "../lib/i18n";
const pt = Astro.url.pathname.startsWith("/pt/");
const localized = (en: string, br: string) => (pt ? br : en);
const paths = languagePaths(Astro.url.pathname);
const home = pt ? "/pt/" : "/";
interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = localized(
    "Java, Quarkus and Spring Boot. Explore Erick Murakami’s backend projects, architecture decisions and engineering trade-offs.",
    "Java, Quarkus e Spring Boot. Conheça os projetos backend, decisões de arquitetura e compromissos técnicos de Erick Murakami.",
  ),
} = Astro.props;
const isNotFound =
  Astro.url.pathname === "/404/" || Astro.url.pathname === "/404.html";
const canonical = new URL(
  isNotFound ? "/404.html" : Astro.url.pathname,
  Astro.site,
);
const links = [
  [`${home}projects/`, localized("Projects", "Projetos")],
  [`${home}notes/`, localized("Engineering notes", "Notas técnicas")],
  [`${home}about/`, localized("About", "Sobre")],
];
---

<!doctype html>
<html lang={pt ? "pt-BR" : "en"} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <meta property="og:type" content="website" />
    <meta
      property="og:site_name"
      content="Erick Murakami · Backend Engineering"
    />
    <meta property="og:title" content={`${title} · Erick Murakami`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content={new URL(pt ? "/social-pt.png" : "/social.png", Astro.site)}
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Erick Murakami — Back-end Software Engineer. Java, Quarkus and Spring Boot."
    />
    <meta name="twitter:card" content="summary_large_image" />
    {(isNotFound || Astro.url.pathname === "/pt/404/") && (
      <meta name="robots" content="noindex" />
    )}
    <link rel="sitemap" href="/sitemap.xml" />
    <title>{title} · Erick Murakami</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(paths.en, Astro.site)} />
    <link
      rel="alternate"
      hreflang="pt-BR"
      href={new URL(paths.pt, Astro.site)}
    />
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(paths.en, Astro.site)}
    />
    <meta property="og:locale" content={pt ? "pt_BR" : "en_US"} />
    <script is:inline>
      try {
        document.documentElement.classList.toggle(
          "dark",
          localStorage.getItem("theme") !== "light",
        );
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">
      {localized("Skip to content", "Ir para o conteúdo")}
    </a>
    <header class="header">
      <div class="shell nav-shell">
        <a
          class="brand"
          href={home}
          aria-label={localized(
            "Erick Murakami home",
            "Página inicial de Erick Murakami",
          )}
        >
          <span class="brand-symbol">
            em<span>.</span>
          </span>
          <span>Erick Murakami</span>
        </a>
        <nav aria-label={localized("Main navigation", "Navegação principal")}>
          {links.map(([href, label]) => (
            <a
              href={href}
              aria-current={
                Astro.url.pathname.startsWith(href) ? "page" : undefined
              }
            >
              {label}
            </a>
          ))}
        </nav>
        <nav class="languages" aria-label={localized("Language", "Idioma")}>
          <a
            href={paths.en}
            lang="en"
            hreflang="en"
            aria-label="English"
            aria-current={!pt ? "true" : undefined}
          >
            EN
          </a>
          <span aria-hidden="true">/</span>
          <a
            href={paths.pt}
            lang="pt-BR"
            hreflang="pt-BR"
            aria-label="Português"
            aria-current={pt ? "true" : undefined}
          >
            PT
          </a>
        </nav>
        <button
          class="theme"
          type="button"
          aria-label={localized("Switch to light theme", "Ativar tema claro")}
          aria-pressed="false"
        >
          <Icon name="sun" />
        </button>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="shell footer">
      <div>
        <a
          class="brand-symbol"
          href={home}
          aria-label={localized("Home", "Início")}
        >
          em<span>.</span>
        </a>
        <p>
          {localized(
            "Thoughtful systems. Deliberate decisions.",
            "Sistemas bem pensados. Decisões conscientes.",
          )}
        </p>
      </div>
      <div class="footer-links">
        <a href="https://github.com/ErickMurakami">GitHub ↗</a>
        <a href="https://www.linkedin.com/in/erick-murakami">LinkedIn ↗</a>
        <a href={`${home}contact/`}>{localized("Contact", "Contato")}</a>
        <span>© {new Date().getFullYear()} Erick Murakami</span>
      </div>
    </footer>
    <script>
      const button = document.querySelector<HTMLButtonElement>(".theme");
      function updateTheme() {
        const light = !document.documentElement.classList.contains("dark");
        button?.setAttribute("aria-pressed", String(light));
        button?.setAttribute(
          "aria-label",
          document.documentElement.lang === "pt-BR"
            ? light
              ? "Ativar tema escuro"
              : "Ativar tema claro"
            : light
              ? "Switch to dark theme"
              : "Switch to light theme",
        );
      }
      updateTheme();
      button?.addEventListener("click", () => {
        document.documentElement.classList.toggle("dark");
        try {
          localStorage.setItem(
            "theme",
            document.documentElement.classList.contains("dark")
              ? "dark"
              : "light",
          );
        } catch {}
        updateTheme();
      });
    </script>
  </body>
</html>
