---
import "../styles/global.css";
import { ClientRouter, fade } from "astro:transitions";
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-500.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/inter/latin-700.css";
import Icon from "../components/Icon.astro";
import { getPublishedPosts } from "../lib/blog";
import { languagePaths } from "../lib/i18n";
const pt = Astro.url.pathname.startsWith("/pt/");
const localized = (en: string, br: string) => (pt ? br : en);
const paths = languagePaths(Astro.url.pathname);
const home = pt ? "/pt/" : "/";
const posts = await getPublishedPosts(pt ? "pt" : "en");
const onBlog = Astro.url.pathname.startsWith(`${home}blog/`);
const blogSlug = onBlog
  ? Astro.url.pathname.slice(`${home}blog/`.length).replace(/\/$/, "")
  : "";
const otherPosts = onBlog ? await getPublishedPosts(pt ? "en" : "pt") : [];
const translatedPageExists =
  !onBlog ||
  (blogSlug
    ? otherPosts.some((post) => post.id === blogSlug)
    : otherPosts.length > 0);
const languageTarget = translatedPageExists
  ? pt
    ? paths.en
    : paths.pt
  : pt
    ? "/"
    : "/pt/";
interface Props {
  title: string;
  projectTitle?: string;
  articleTitle?: string;
  description?: string;
}
const {
  title,
  projectTitle,
  articleTitle,
  description = localized(
    "Backend projects by Erick Murakami: personal finance, delivery orders, Redis rate limiting and PostgreSQL multitenancy.",
    "Projetos backend de Erick Murakami: finanças pessoais, gestão de pedidos, controle de requisições com Redis e multitenancy com PostgreSQL.",
  ),
} = Astro.props;
const isNotFound =
  Astro.url.pathname === "/404/" || Astro.url.pathname === "/404.html";
const canonical = new URL(
  isNotFound ? "/404.html" : Astro.url.pathname,
  Astro.site,
);
const links = [
  [`${home}#projects`, localized("Projects", "Projetos")],
  [`${home}#about`, localized("About", "Sobre")],
  [`${home}#contact`, localized("Contact", "Contato")],
];
if (posts.length) links.splice(1, 0, [`${home}blog/`, "Blog"]);
---

<!doctype html>
<html lang={pt ? "pt-BR" : "en"} class="dark" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <ClientRouter fallback="swap" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <meta property="og:type" content="website" />
    <meta
      property="og:site_name"
      content="Erick Murakami · Backend Engineering"
    />
    <meta property="og:title" content={`${title} · Erick Murakami`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content={new URL(pt ? "/social-pt.png" : "/social.png", Astro.site)}
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Erick Murakami — Back-end Software Engineer. Java, Quarkus and Spring Boot."
    />
    <meta name="twitter:card" content="summary_large_image" />
    {(isNotFound || Astro.url.pathname === "/pt/404/") && (
      <meta name="robots" content="noindex" />
    )}
    <link rel="sitemap" href="/sitemap.xml" />
    <title>{title} · Erick Murakami</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {(!pt || translatedPageExists) && (
      <link
        rel="alternate"
        hreflang="en"
        href={new URL(paths.en, Astro.site)}
      />
    )}
    {(pt || translatedPageExists) && (
      <link
        rel="alternate"
        hreflang="pt-BR"
        href={new URL(paths.pt, Astro.site)}
      />
    )}
    <link
      rel="alternate"
      hreflang="x-default"
      href={
        new URL(
          pt && !translatedPageExists ? Astro.url.pathname : paths.en,
          Astro.site,
        )
      }
    />
    <meta property="og:locale" content={pt ? "pt_BR" : "en_US"} />
    <script is:inline>
      try {
        document.documentElement.classList.toggle(
          "dark",
          localStorage.getItem("theme") !== "light",
        );
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">
      {localized("Skip to content", "Ir para o conteúdo")}
    </a>
    <header
      class="header"
      transition:name="site-header"
      transition:animate="none"
    >
      <div class="shell nav-shell">
        <a
          class="brand"
          href={home}
          aria-label={localized(
            "Erick Murakami home",
            "Página inicial de Erick Murakami",
          )}
        >
          <span class="brand-symbol">
            em<span>.</span>
          </span>
          <span>Erick Murakami</span>
        </a>
        <nav
          class="primary-nav"
          aria-label={localized("Main navigation", "Navegação principal")}
        >
          {links.map(([href, label]) => (
            <a
              href={href}
              aria-current={
                href.endsWith("#projects") &&
                Astro.url.pathname.includes("/projects/")
                  ? "true"
                  : href === Astro.url.pathname
                    ? "page"
                    : undefined
              }
            >
              {label}
            </a>
          ))}
        </nav>
        <a
          class="language-toggle"
          href={languageTarget}
          hreflang={pt ? "en" : "pt-BR"}
          aria-label={localized(
            "Language: English. Switch to Portuguese",
            "Idioma: português. Mudar para inglês",
          )}
          title={localized("Switch to Portuguese", "Mudar para inglês")}
        >
          <img
            class="language-flag"
            src={pt ? "/flags/brazil.svg" : "/flags/united-kingdom.svg"}
            alt=""
            width="24"
            height="18"
            aria-hidden="true"
          />
        </a>
        <button
          class="theme"
          type="button"
          aria-label={localized("Switch to light theme", "Ativar tema claro")}
          aria-pressed="false"
        >
          <Icon name="sun" />
        </button>
      </div>
      {(projectTitle || articleTitle) && (
        <div class="shell case-bar" data-case-bar>
          <a
            class="case-back"
            href={articleTitle ? `${home}blog/` : `${home}#projects`}
          >
            {articleTitle
              ? localized("← All articles", "← Todos os artigos")
              : localized("← All projects", "← Todos os projetos")}
          </a>
          <h1 class="case-title">{projectTitle || articleTitle}</h1>
        </div>
      )}
    </header>
    <main
      id="main"
      tabindex="-1"
      transition:name="page-content"
      transition:animate={fade({ duration: "180ms" })}
    >
      <slot />
    </main>
    <footer class="shell footer">
      <div>
        <a
          class="brand-symbol"
          href={home}
          aria-label={localized("Home", "Início")}
        >
          em<span>.</span>
        </a>
      </div>
      <div class="footer-links">
        <a href="https://github.com/ErickMurakami">GitHub ↗</a>
        <a href="https://www.linkedin.com/in/erick-murakami">LinkedIn ↗</a>
        <a href={`${home}#contact`}>{localized("Contact", "Contato")}</a>
        <span>© {new Date().getFullYear()} Erick Murakami</span>
      </div>
    </footer>
    <script>
      import "../scripts/navigation";
    </script>
  </body>
</html>
